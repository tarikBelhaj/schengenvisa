// Auth : Google OAuth uniquement (NextAuth v4 + @auth/prisma-adapter)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DATABASE_URL poolée, DIRECT_URL directe pour les migrations.
  directUrl = env("DIRECT_URL")
}

// NextAuth

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  persons  Person[]
  dogs     Dog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Métier

model Person {
  id          String   @id @default(cuid())
  userId      String
  name        String
  nationality String?
  notes       String?
  // Data URL JPEG, redimensionnée à 256px avant envoi. Pas de stockage
  // externe à gérer pour une poignée de vignettes.
  photo       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips Trip[]

  @@index([userId])
}

enum TripStatus {
  PAST
  PLANNED
}

model Trip {
  id       String     @id @default(cuid())
  personId String
  // @db.Date : pas d'heure, donc pas de décalage de fuseau.
  entryDate DateTime  @db.Date
  // null = séjour en cours
  exitDate  DateTime? @db.Date
  status    TripStatus
  country   String?
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([personId, entryDate])
}

// Pets Entry

enum DogSex {
  MALE
  FEMALE
}

enum VetRecordType {
  RABIES_VACCINE
  CHPPI_VACCINE
  LEPTOSPIROSIS_VACCINE
  BORDETELLA_VACCINE
  DEWORMING
  ANTIPARASITIC
  RABIES_TITER
  HEALTH_CERTIFICATE
  IMPORT_PERMIT
  OTHER
}

model Dog {
  id            String    @id @default(cuid())
  userId        String
  name          String
  breed         String?
  sex           DogSex?
  birthDate     DateTime? @db.Date
  microchip     String?
  photo         String?   @db.Text
  // ISO 3166-1 alpha-2, aligné sur les clés de src/travel-rules.
  countryCode   String?
  euPassport    String?
  weightKg      Float?
  color         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  records VetRecord[]

  @@index([userId])
}

model VetRecord {
  id        String        @id @default(cuid())
  dogId     String
  type      VetRecordType
  date      DateTime      @db.Date
  // null = document sans échéance (certificat ponctuel, note…).
  expiresAt DateTime?     @db.Date
  note      String?
  label     String?
  // Pièce jointe en data URL. Voir MAX_ATTACHMENT_BYTES côté validation.
  fileName  String?
  fileType  String?
  fileData  String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId])
  @@index([dogId, date])
}
