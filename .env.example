# --- Base de données -------------------------------------------------------
# Neon / Supabase : DATABASE_URL est l'URL *poolée*, DIRECT_URL l'URL directe
# (les migrations Prisma ne passent pas par le pooler).
# Neon    : ...-pooler.region.aws.neon.tech/... ?sslmode=require
# Supabase: port 6543 (pooler) vs 5432 (direct)
DATABASE_URL="postgresql://user:password@host:5432/schengen?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/schengen?sslmode=require"

# --- NextAuth --------------------------------------------------------------
# En local : http://localhost:3000 — en prod : l'URL du déploiement Vercel.
NEXTAUTH_URL="http://localhost:3000"
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Google OAuth ----------------------------------------------------------
# console.cloud.google.com → API et services → Identifiants → ID client OAuth
# URI de redirection autorisée : <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Accès (optionnel) -----------------------------------------------------
# Liste blanche d'adresses autorisées à se connecter. Vide = tout compte Google.
ALLOWED_EMAILS=""

# --- Alertes e-mail (optionnel) --------------------------------------------
# Le cron quotidien /api/cron/alerts prévient quand il reste 10 jours, 0 jour,
# ou en cas de dépassement. Sans RESEND_API_KEY, rien n'est envoyé : le cron
# répond alors `failures: ["RESEND_API_KEY absente"]`.
# Clé sur resend.com → API Keys.
RESEND_API_KEY=""
# Expéditeur. Le domaine doit être vérifié chez Resend ; à défaut, laisser vide
# pour retomber sur `onboarding@resend.dev`, qui n'écrit qu'à votre adresse
# de compte Resend.
ALERT_FROM=""
# Protège la route du cron. Vide = route ouverte, donc envois déclenchables par
# n'importe qui : à renseigner en production. Vercel envoie automatiquement
# l'en-tête `Authorization: Bearer <CRON_SECRET>` à ses crons.
# Générer avec : openssl rand -base64 32
CRON_SECRET=""

# --- Seed ------------------------------------------------------------------
# Adresse Google du compte de démonstration créé par `npm run db:seed`.
SEED_USER_EMAIL=""
