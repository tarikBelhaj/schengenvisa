# --- Base de données -------------------------------------------------------
# Neon / Supabase : DATABASE_URL est l'URL *poolée*, DIRECT_URL l'URL directe
# (les migrations Prisma ne passent pas par le pooler).
# Neon    : ...-pooler.region.aws.neon.tech/... ?sslmode=require
# Supabase: port 6543 (pooler) vs 5432 (direct)
DATABASE_URL="postgresql://user:password@host:5432/schengen?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/schengen?sslmode=require"

# --- NextAuth --------------------------------------------------------------
# En local : http://localhost:3000 — en prod : l'URL du déploiement Vercel.
NEXTAUTH_URL="http://localhost:3000"
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Google OAuth ----------------------------------------------------------
# console.cloud.google.com → API et services → Identifiants → ID client OAuth
# URI de redirection autorisée : <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Accès (optionnel) -----------------------------------------------------
# Liste blanche d'adresses autorisées à se connecter. Vide = tout compte Google.
ALLOWED_EMAILS=""

# --- Seed ------------------------------------------------------------------
# Adresse Google du compte de démonstration créé par `npm run db:seed`.
SEED_USER_EMAIL=""
